<idea-plugin>
  <id>dev.tinkr.companion</id>
  <name>Tinkr</name>
  <vendor>thunderkex</vendor>
  <description>Thin status widget and Tinkr: Doctor action talking only to the local tinkr binary.</description>
  <depends>com.intellij.modules.platform</depends>
  <actions>
    <action id="Tinkr.Doctor" class="dev.tinkr.TinkrDoctorAction" text="Tinkr: Doctor" description="Run tinkr doctor --fix">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
